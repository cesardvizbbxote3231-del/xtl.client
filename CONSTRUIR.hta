<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta http-equiv="x-ua-compatible" content="ie=edge">
<title>XTL Client Setup</title>
<hta:application id="app" applicationname="XTL Client Setup" border="thin" caption="yes" maximizebutton="no" scroll="no" singleinstance="yes" />
<style>
body{margin:0;padding:34px 38px;background:#09090b;color:#ededed;font:15px "Segoe UI",sans-serif;overflow:hidden}
h1{margin:0 0 4px;font:800 30px "Segoe UI";letter-spacing:-1px}h1 i{color:#6ea8ff;font-style:normal}
p{margin:0 0 22px;color:#8a8a93}
.s{padding:9px 0;border-bottom:1px solid #1f1f27;color:#8a8a93}.s b{display:inline-block;width:26px;color:#8a8a93}
.s.on{color:#ededed}.s.on b{color:#6ea8ff}.s.ok{color:#ededed}.s.ok b{color:#6ea8ff}.s.bad{color:#ff7a85}.s.bad b{color:#ff7a85}
#bar{height:4px;background:#1f1f27;margin:22px 0 10px}#fill{height:4px;width:0;background:#6ea8ff}
#log{height:20px;overflow:hidden;color:#8a8a93;font-size:12px;white-space:nowrap}
button{margin-top:18px;background:#6ea8ff;color:#04130c;border:0;padding:12px 26px;font:700 15px "Segoe UI";cursor:pointer}
button.g{background:#111116;color:#ededed;border:1px solid #1f1f27;margin-left:8px}
</style></head><body>
<h1>XTL<i> CLIENT</i></h1><p>Instalador. Un clic y listo, sin consola.</p>
<div id="list"></div><div id="bar"><div id="fill"></div></div><div id="log">Listo para empezar.</div>
<button id="go" onclick="start()">Comenzar</button>
<span id="end" style="display:none"><button onclick="runSetup()">Instalar XTL Client</button><button class="g" onclick="openDist()">Abrir carpeta</button></span>
<script language="JScript">
window.resizeTo(560,500);
var sh=new ActiveXObject("WScript.Shell"),fso=new ActiveXObject("Scripting.FileSystemObject");
var dir=fso.GetParentFolderName(unescape(location.pathname).replace(/^\/(?=[A-Za-z]:)/,"").replace(/\//g,"\\"));
var tmp=sh.ExpandEnvironmentStrings("%TEMP%"),bat=tmp+"\\xtl-step.bat",logf=tmp+"\\xtl-step.log",codef=tmp+"\\xtl-step.code";
var hasNode=false,i=0,timer=null;
var NODE='winget install -e --id OpenJS.NodeJS.LTS --silent --accept-package-agreements --accept-source-agreements || powershell -NoProfile -Command "$ErrorActionPreference=\'Stop\';[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12;$v=(Invoke-RestMethod https://nodejs.org/dist/index.json|Where-Object{$_.lts}|Select-Object -First 1).version;$f=$env:TEMP+\'\\node-setup.msi\';Invoke-WebRequest (\'https://nodejs.org/dist/\'+$v+\'/node-\'+$v+\'-x64.msi\') -OutFile $f;Start-Process msiexec -ArgumentList \'/i\',$f,\'/qn\',\'/norestart\' -Verb RunAs -Wait"';
var steps=[
 {t:"Comprobar Node.js",cmd:"node -v",soft:true},
 {t:"Instalar Node.js (solo si falta)",cmd:NODE,skip:function(){return hasNode}},
 {t:"Descargar componentes",cmd:"call npm install"},
 {t:"Crear el instalador",cmd:"call npm run dist"}];
function draw(){var h="";for(var k=0;k<steps.length;k++){var s=steps[k];h+='<div class="s '+(s.st||"")+'"><b>'+(s.st=="ok"?"✓":s.st=="bad"?"✗":s.st=="on"?"●":"○")+'</b>'+s.t+'</div>'}document.getElementById("list").innerHTML=h;document.getElementById("fill").style.width=Math.round(i/steps.length*100)+"%"}
function start(){document.getElementById("go").style.display="none";next()}
function next(){
 if(i>=steps.length){finish();return}
 var s=steps[i];
 if(s.skip&&s.skip()){s.st="ok";i++;draw();next();return}
 s.st="on";draw();
 var f=fso.CreateTextFile(bat,true);
 f.WriteLine("@echo off");f.WriteLine('cd /d "'+dir+'"');f.WriteLine('set "PATH=%PATH%;%ProgramFiles%\\nodejs\\"');
 f.WriteLine(s.cmd+' > "'+logf+'" 2>&1');f.WriteLine('echo %errorlevel% > "'+codef+'"');f.Close();
 if(fso.FileExists(codef))fso.DeleteFile(codef);
 sh.Run('"'+bat+'"',0,false);
 timer=setInterval(poll,600);
}
function poll(){
 try{if(fso.FileExists(logf)){var t=fso.OpenTextFile(logf,1,false,0);var a=t.ReadAll().replace(/\s+$/,"").split("\n");t.Close();document.getElementById("log").innerText=a[a.length-1].substr(0,90)}}catch(e){}
 if(!fso.FileExists(codef))return;
 clearInterval(timer);
 var c=fso.OpenTextFile(codef,1,false,0);var code=parseInt(c.ReadLine(),10);c.Close();
 var s=steps[i];
 if(s.soft){hasNode=(code==0);s.st="ok"}
 else if(code!=0){s.st="bad";draw();document.getElementById("log").innerText="Error en este paso. Revisa tu conexion a internet y vuelve a abrir el instalador.";return}
 else s.st="ok";
 i++;draw();next();
}
function installerPath(){var d=dir+"\\dist";if(!fso.FolderExists(d))return "";var e=new Enumerator(fso.GetFolder(d).Files);for(;!e.atEnd();e.moveNext()){if(/Setup.*\.exe$/i.test(e.item().Name))return e.item().Path}return ""}
function finish(){document.getElementById("log").innerText="Listo. Tu instalador esta en la carpeta dist.";document.getElementById("end").style.display="inline"}
function runSetup(){var p=installerPath();if(p)sh.Run('"'+p+'"',1,false);else alert("No encontre el instalador en la carpeta dist.")}
function openDist(){sh.Run('explorer "'+dir+'\\dist"',1,false)}
draw();
</script></body></html>
